# Is file ko copy karke `.env` banao aur values bharo. `.env` GitHub par push mat karna.

SHOPIFY_SHOP=maplestore-in
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx

GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxx

# OTP aur log mail isi address se jaayenge (Brevo mein verified sender hona chahiye)
SENDER_EMAIL=you@yourcompany.com
SENDER_NAME=Maple Uploader

# Option A — Gmail SMTP (sirf local / Render paid plan par chalta hai)
SENDER_APP_PASSWORD=

# Option B — Brevo API (Render Free plan ke liye zaroori)
BREVO_API_KEY=

FLASK_SECRET_KEY=koi-bhi-lamba-random-string
OTP_EXPIRY_SECONDS=300
SESSION_TIMEOUT_MINUTES=30
